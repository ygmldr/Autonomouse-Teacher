@dataclass(frozen=True)
class ControllerDecision:
    status: str
    reasons: tuple[str, ...]
    authorization_approved: bool
    gate_status: str
    candidate_command_checked: bool
    candidate_credentials_checked: bool
    boundary_deployed: bool = False
    signature_valid: bool = False
    billable_send_authorized: bool = False

    def __post_init__(self) -> None:
        if self.billable_send_authorized:
            raise ValueError("the inspect-only controller can never authorize a billable send")


