{
  "schema": "m0.g4b.inventory.spec.v1",
  "purpose": "Deterministic closure of the bytes that the G4-B frozen runtime actually loads or is configured by. No key, no model, no network, no container start.",
  "canonicalization": {
    "json_sort_keys": true,
    "json_separators": [",", ":"],
    "json_ensure_ascii": false,
    "json_allow_nan": false,
    "trailing_newline": true,
    "path_sort": "unicode-codepoint-ascending on POSIX relative path",
    "path_separator": "/",
    "mode_format": "4-digit octal from lstat (no follow)",
    "digest": "sha256 over canonical JSON of {schema,canonicalization,anchor,inputs,derived}",
    "self_reference": "manifest.json and manifest.sha256 are never listed and never hashed; the digest is stored beside the manifest",
    "provenance_excluded": true,
    "default_stage": "artifacts/g3d/stage-20261117T221955Z"
  },
